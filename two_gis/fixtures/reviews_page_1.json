1095682582290366464/f571e410-ca55-49e5-85a8-38db6b765e9d/1/ru/image_320.png", "640x": "https://ams2-cdn.2gis.com/previews/1095682582290366464/f571e410-ca55-49e5-85a8-38db6b765e9d/1/ru/image_640.png", "64x64": "https://ams2-cdn.2gis.com/previews/1095682582290366464/f571e410-ca55-49e5-85a8-38db6b765e9d/1/ru/image_64_64.png", "url": "https://ams2-cdn.2gis.com/previews/1095682582290366464/f571e410-ca55-49e5-85a8-38db6b765e9d/1/ru/image.png"}, "org_name": "Руки Вверх!, бар", "text": "Спасибо! Легендарный коктейль Love is и сытные блюда, знакомые с детства, уже стали нашей визитной карточкой. Рады, что вам было вкусно!"}, "provider": "2gis", "rating": 5, "region_id": 32, "source": null, "text": "Шикарное атмосферное заведение! Посетили стендап по-женски)🔥🔥🔥\nВкусная кухня, большое разнообразие коктейлей и ещё много чего!) обязательно придем сюда снова с женой и друзьями)", "trust_factors": {"factors": [{"caption": "1 visit", "icon": "https://cachizer1.2gis.com/reviews-logos/0a13e48a-4335-4988-b02a-f0b2e77c3a5f.png?h={height}&w={width}", "last_visit": "2026-11-05T16:20:13.0Z", "type": "location_visit", "visits_count": 1}], "trust_info": {"caption": "1 visit", "confirmed_caption": "Review confirmed"}}, "url": "", "user": {"additional_data": {"email": null}, "first_name": "Александр Экерт", "id": "69007427", "last_name": null, "name": "Александр Экерт", "photo_preview_urls": {"1920x": "", "320x": "", "640x": "", "64x64": "", "url": ""}, "provider": "2gis", "public_id": "d15f5167b4284219b346f53692f4ccb9", "reviews_count": 2, "url": ""}}, {"additional_data": {"external_id": null, "filtered_facts": null, "has_unresolved_complaints": false, "ip": "", "is_liked": null, "is_unrated_permanently": null, "pin_status": "none", "status_history": [], "user_agent": ""}, "comments_count": 1, "date_created": "2026-11-05T03:38:39.480469+07:00", "date_edited": null, "hiding_reason": null, "hiding_type": null, "id": "313664504", "is_hidden": false, "is_rated": true, "likes_count": 0, "media": [{"photo": {"date_created": "2026-11-05T03:38:39.529677+07:00", "id": "42864294", "preview_urls": {"1920x": "https://cachizer3.2gis.com/reviews-photos/39a2ff26-e6d2-41ea-9a88-3e7814182856.jpg?w=1920", "320x": "https://cachizer3.2gis.com/reviews-photos/39a2ff26-e6d2-41ea-9a88-3e7814182856.jpg?w=320", "640x": "https://cachizer3.2gis.com/reviews-photos/39a2ff26-e6d2-41ea-9a88-3e7814182856.jpg?w=640", "64x64": "https://cachizer3.2gis.com/reviews-photos/39a2ff26-e6d2-41ea-9a88-3e7814182856.jpg?h=64&w=64", "url": "https://cachizer3.2gis.com/reviews-photos/39a2ff26-e6d2-41ea-9a88-3e7814182856.jpg"}, "processing_status": "finished", "visibility_status": "visible"}}], "object": {"id": "70000001034739765", "type": "branch"}, "official_answer": {"date_created": "2026-11-14T03:20:39.918245+07:00", "id": "75933307", "logo_preview_urls": {"1920x": "https://ams2-cdn.2gis.com/previews/1095682582290366464/f571e410-ca55-49e5-85a8-38db6b765e9d/1/ru/image_1920.png", "320x": "https://ams2-cdn.2gis.com/previews/1095682582290366464/f571e410-ca55-49e5-85a8-38db6b765e9d/1/ru/image_320.png", "640x": "https://ams2-cdn.2gis.com/previews/1095682582290366464/f571e410-ca55-49e5-85a8-38db6b765e9d/1/ru/image_640.png", "64x64": "https://ams2-cdn.2gis.com/previews/1095682582290366464/f571e410-ca55-49e5-85a8-38db6b765e9d/1/ru/image_64_64.png", "url": "https://ams2-cdn.2gis.com/previews/1095682582290366464/f571e410-ca55-49e5-85a8-38db6b765e9d/1/ru/image.png"}, "org_name": "Руки Вверх!, бар", "text": "Наталья, здравствуйте!\nБлагодарим вас за то, что поделились своим мнением после визита.😊\nНам очень жаль, что тайминги подачи закусок и порядок проведения расчетов во время концерта не в полной мере совпали с вашими ожиданиями.\nПерсонал зала всегда ориентирован на своевременное выполнение заказов в соответствии с загруженностью кухни во время массовых мероприятий.\nПо поводу сервисного сбора - понимаем, вызывает вопросы. Мы обязательно пересмотрим этот момент, чтобы сделать процесс оплаты прозрачнее и комфортнее.\nЕсли решите дать ещё один шанс, сделаем всё, чтобы изменить ваше впечатление! 🙏🏼"}, "provider": "2gis", "rating": 1, "region_id": 32, "source": null, "text": "Была в баре Руки Вверх на Тверской 22 на концерте Валерия Сюткина 1 ноября. Концерт очень понравился!!! \nНо разочаровалась в обслуживании. Я ходила вдвоем и покупала два билета за первый столик. Пришла заранее и заказала два кофе, два лимонада и сырную тарелку. Кофе и лимонад официант принес быстро, а сырную тарелку забыл, но не забыл включить ее в счет и взять еще с нас двоих сервисный сбор 10 процентов, хотя сервисный сбор берется только с компаний от 6 человек (эта информация указана на сайте бара) . На мой вопрос, почему сумма для оплаты больше, чем в чеке он ответил, что сервисный сбор, нужно заплатить, и принес сырную тарелку за 30 минут до окончания концерта.", "url": "", "user": {"additional_data": {"email": null}, "first_name": "Наталья Чукреева", "id": "99469313", "last_name": null, "name": "Наталья Чукреева", "photo_preview_urls": {"1920x": "", "320x": "", "640x": "", "64x64": "", "url": ""}, "provider": "2gis", "public_id": "66c258da129a46459e21bf9f8b4e6feb", "reviews_count": 3, "url": ""}}, {"additional_data": {"external_id": null, "filtered_facts": null, "has_unresolved_complaints": false, "ip": "", "is_liked": null, "is_unrated_permanently": null, "pin_status": "none", "status_history": [], "user_agent": ""}, "comments_count": 1, "date_created": "2026-10-31T05:47:18.622026+07:00", "date_edited": null, "hiding_reason": null, "hiding_type": null, "id": "311747994", "is_hidden": false, "is_rated": true, "likes_count": 0, "media": [], "object": {"id": "70000001034739765", "type": "branch"}, "official_answer": {"date_created": "2026-10-31T07:14:36.457378+07:00", "id": "75086061", "logo_preview_urls": {"1920x": "https://ams2-cdn.2gis.com/previews/1095682582290366464/f571e410-ca55-49e5-85a8-38db6b765e9d/1/ru/image_1920.png", "320x": "https://ams2-cdn.2gis.com/previews/1095682582290366464/f571e410-ca55-49e5-85a8-38db6b765e9d/1/ru/image_320.png", "640x": "https://ams2-cdn.2gis.com/previews/1095682582290366464/f571e410-ca55-49e5-85a8-38db6b765e9d/1/ru/image_640.png", "64x64": "https://ams2-cdn.2gis.com/previews/1095682582290366464/f571e410-ca55-49e5-85a8-38db6b765e9d/1/ru/image_64_64.png", "url": "https://ams2-cdn.2gis.com/previews/1095682582290366464/f571e410-ca55-49e5-85a8-38db6b765e9d/1/ru/image.png"}, "org_name": "Руки Вверх!, бар", "text": "Приятно слышать! Наш клуб с танцполом всегда открыт для тех, кто готов отжигать под любимые мотивы. До скорой встречи на вечеринках!"}, "provider": "2gis", "rating": 5, "region_id": 32, "source": null, "text": "Все понравилось отлично", "url": "", "user": {"additional_data": {"email": null}, "first_name": "Анастасия Шехватова", "id": "23304555", "last_name": null, "name": "Анастасия Шехватова", "photo_preview_urls": {"1920x": "https://i1.photo.2gis.com/images/profile/30258560047696754_5812_1920x.jpg", "320x": "https://i1.photo.2gis.com/images/profile/30258560047696754_5812_320x.jpg", "640x": "https://i1.photo.2gis.com/images/profile/30258560047696754_5812_640x.jpg", "64x64": "https://i1.photo.2gis.com/images/profile/30258560047696754_5812_64x64.jpg", "url": "https://i1.photo.2gis.com/images/profile/30258560047696754_5812.jpg"}, "provider": "2gis", "public_id": "e8c0982298c143a6bc5a2e6218947711", "reviews_count": 6, "url": ""}}]}