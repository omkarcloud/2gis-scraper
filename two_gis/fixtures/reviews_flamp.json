g", "320x": "https://cdn1.flamp.ru/b134bd8ca00bdda93e1f5b454387b1fb_320.jpeg", "640x": "https://cdn1.flamp.ru/b134bd8ca00bdda93e1f5b454387b1fb_640.jpeg", "64x64": "https://cdn1.flamp.ru/b134bd8ca00bdda93e1f5b454387b1fb_64_64.jpeg", "url": "https://cdn1.flamp.ru/b134bd8ca00bdda93e1f5b454387b1fb.jpeg"}, "processing_status": "finished", "visibility_status": "visible"}}, {"photo": {"date_created": "2024-03-11T17:02:23.0+07:00", "id": "9035616", "preview_urls": {"1920x": "https://cdn1.flamp.ru/425809d5aa5d3a9c7ac57d9eacf80db4_1920.jpeg", "320x": "https://cdn1.flamp.ru/425809d5aa5d3a9c7ac57d9eacf80db4_320.jpeg", "640x": "https://cdn1.flamp.ru/425809d5aa5d3a9c7ac57d9eacf80db4_640.jpeg", "64x64": "https://cdn1.flamp.ru/425809d5aa5d3a9c7ac57d9eacf80db4_64_64.jpeg", "url": "https://cdn1.flamp.ru/425809d5aa5d3a9c7ac57d9eacf80db4.jpeg"}, "processing_status": "finished", "visibility_status": "visible"}}, {"photo": {"date_created": "2024-03-11T17:02:25.0+07:00", "id": "9035617", "preview_urls": {"1920x": "https://cdn1.flamp.ru/fd8b97e0ea0f7722fb67847d61d71ad3_1920.jpeg", "320x": "https://cdn1.flamp.ru/fd8b97e0ea0f7722fb67847d61d71ad3_320.jpeg", "640x": "https://cdn1.flamp.ru/fd8b97e0ea0f7722fb67847d61d71ad3_640.jpeg", "64x64": "https://cdn1.flamp.ru/fd8b97e0ea0f7722fb67847d61d71ad3_64_64.jpeg", "url": "https://cdn1.flamp.ru/fd8b97e0ea0f7722fb67847d61d71ad3.jpeg"}, "processing_status": "finished", "visibility_status": "visible"}}, {"photo": {"date_created": "2024-03-11T17:02:26.0+07:00", "id": "9035618", "preview_urls": {"1920x": "https://cdn1.flamp.ru/b4a56d29e2fbd797a1f2342a7ee110f8_1920.jpeg", "320x": "https://cdn1.flamp.ru/b4a56d29e2fbd797a1f2342a7ee110f8_320.jpeg", "640x": "https://cdn1.flamp.ru/b4a56d29e2fbd797a1f2342a7ee110f8_640.jpeg", "64x64": "https://cdn1.flamp.ru/b4a56d29e2fbd797a1f2342a7ee110f8_64_64.jpeg", "url": "https://cdn1.flamp.ru/b4a56d29e2fbd797a1f2342a7ee110f8.jpeg"}, "processing_status": "finished", "visibility_status": "visible"}}], "object": {"id": "70000001034739765", "type": "branch"}, "official_answer": {"date_created": "2024-03-14T16:21:56.0+07:00", "id": "27077360", "logo_preview_urls": {"1920x": "https://cdn1.flamp.ru/2b75669efe5efdcb62cd9417037ffb5c_1920.jpg", "320x": "https://cdn1.flamp.ru/2b75669efe5efdcb62cd9417037ffb5c_320.jpg", "640x": "https://cdn1.flamp.ru/2b75669efe5efdcb62cd9417037ffb5c_640.jpg", "64x64": "https://cdn1.flamp.ru/2b75669efe5efdcb62cd9417037ffb5c_64_64.jpg", "url": "https://cdn1.flamp.ru/2b75669efe5efdcb62cd9417037ffb5c.jpg"}, "org_name": "Руки Вверх!, бар", "text": "Добрый день, Вероника.\nОчереди... Дело в том, что мы так любим наших гостей, что очень сложно отказать кому-то на входе.\nА желающих классно провести с нами время очень много.\nВидимо, цены все же не такие уж космические 😉\nПриходите снова, очень хотим, чтобы вам у нас понравилось!"}, "provider": "flamp", "provider_data": {"caption": "Flamp", "icon_url": "https://cachizer1.2gis.com/reviews-logos/984693dc-de95-4acc-8d1b-35d906b17374.png?h={height}&w={width}"}, "rating": 3, "region_id": 32, "source": null, "text": "Ходили в бар на стенд ап 8 марта, в целом все норм, но цены космос, сырные палочки 880 р, коктейля ценой ниже 700 рублей нет, очередь в женский туалет огромнейшая. Мало столов на большую компанию, нас было 6 человек, сидели за столом 15, рядом стоял почти такой же стол №14, но на 6 человек, можно же сделать 15 стол таким же как 14\n\nПодача Маргариты вообще удивила, как будто шампанское заказала.", "url": "https://flamp.ru/r/70000001034739765/8877455", "user": {"additional_data": {"email": null}, "first_name": "Вероника", "id": "2592798", "last_name": null, "name": "Вероника", "photo_preview_urls": {"1920x": "https://cdn1.flamp.ru/3f2fecfbf0ee7ef2a4a76c39942e30ce_1920.jpg", "320x": "https://cdn1.flamp.ru/3f2fecfbf0ee7ef2a4a76c39942e30ce_320.jpg", "640x": "https://cdn1.flamp.ru/3f2fecfbf0ee7ef2a4a76c39942e30ce_640.jpg", "64x64": "https://cdn1.flamp.ru/3f2fecfbf0ee7ef2a4a76c39942e30ce_64_64.jpg", "url": "https://cdn1.flamp.ru/3f2fecfbf0ee7ef2a4a76c39942e30ce.jpg"}, "provider": "flamp", "public_id": null, "reviews_count": 147, "url": "http://flamp.ru/user2592798"}}, {"additional_data": {"external_id": "8745237", "filtered_facts": null, "has_unresolved_complaints": false, "ip": "", "is_liked": null, "is_unrated_permanently": null, "pin_status": "none", "status_history": [], "user_agent": ""}, "comments_count": 1, "date_created": "2023-12-20T11:22:04.0+07:00", "date_edited": null, "hiding_reason": null, "hiding_type": null, "id": "68381226", "is_hidden": false, "is_rated": true, "likes_count": 0, "media": [], "object": {"id": "70000001034739765", "type": "branch"}, "official_answer": {"date_created": "2023-12-21T15:58:00.0+07:00", "id": "24284668", "logo_preview_urls": {"1920x": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_1920.png", "320x": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_320.png", "640x": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_640.png", "64x64": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_64_64.png", "url": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77.png"}, "org_name": "Руки Вверх!, бар", "text": "Ваш визит мы запомним надолго 🥰\nПриезжайте ещё! Вся команда будет по вам скучать 🧡"}, "provider": "flamp", "provider_data": {"caption": "Flamp", "icon_url": "https://cachizer1.2gis.com/reviews-logos/984693dc-de95-4acc-8d1b-35d906b17374.png?h={height}&w={width}"}, "rating": 5, "region_id": 32, "source": null, "text": "Часто сюда ходим с друзьями, всегда позитивная атмосфера) Все на уровне, сотрудники супер вежливые, обслуживание качественное!", "url": "https://flamp.ru/r/70000001034739765/8745237", "user": {"additional_data": {"email": null}, "first_name": "Альбина", "id": "4929275", "last_name": null, "name": "Альбина", "photo_preview_urls": {"1920x": "https://cdn1.flamp.ru/e27d0425845d1386abca234d39dd9743_1920.jpg", "320x": "https://cdn1.flamp.ru/e27d0425845d1386abca234d39dd9743_320.jpg", "640x": "https://cdn1.flamp.ru/e27d0425845d1386abca234d39dd9743_640.jpg", "64x64": "https://cdn1.flamp.ru/e27d0425845d1386abca234d39dd9743_64_64.jpg", "url": "https://cdn1.flamp.ru/e27d0425845d1386abca234d39dd9743.jpg"}, "provider": "flamp", "public_id": null, "reviews_count": 3, "url": "http://flamp.ru/user4929275"}}, {"additional_data": {"external_id": "8729776", "filtered_facts": null, "has_unresolved_complaints": false, "ip": "", "is_liked": null, "is_unrated_permanently": null, "pin_status": "none", "status_history": [], "user_agent": ""}, "comments_count": 1, "date_created": "2023-12-12T05:30:54.0+07:00", "date_edited": null, "emojis": [{"count": 1, "date_created": "2023-12-12T05:30:54.0+07:00", "id": "green_heart", "is_liked": false, "items": [{"date_created": "2023-12-12T06:00:05.0Z", "user": {"id": "45040900", "name": "Иван Самсонов", "photo_preview_urls": {"1920x": "https://i6.photo.2gis.com/images/profile/30258560114533212_626e_1920x.jpg", "320x": "https://i6.photo.2gis.com/images/profile/30258560114533212_626e_320x.jpg", "640x": "https://i6.photo.2gis.com/images/profile/30258560114533212_626e_640x.jpg", "64x64": "https://i6.photo.2gis.com/images/profile/30258560114533212_626e_64x64.jpg", "url": "https://i6.photo.2gis.com/images/profile/30258560114533212_626e.jpg"}, "public_id": "c5e1a7f201ec44e9963183fb4c7aaeb2"}}]}], "hiding_reason": null, "hiding_type": null, "id": "67609509", "is_hidden": false, "is_rated": true, "likes_count": 1, "media": [], "object": {"id": "70000001034739765", "type": "branch"}, "official_answer": {"date_created": "2023-12-13T17:03:58.0+07:00", "id": "24025952", "logo_preview_urls": {"1920x": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_1920.png", "320x": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_320.png", "640x": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_640.png", "64x64": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_64_64.png", "url": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77.png"}, "org_name": "Руки Вверх!, бар", "text": "Отличные новости!\nПриходите еще, будем вашими постоянными поставщиками радости и веселья 😊"}, "provider": "flamp", "provider_data": {"caption": "Flamp", "icon_url": "https://cachizer1.2gis.com/reviews-logos/984693dc-de95-4acc-8d1b-35d906b17374.png?h={height}&w={width}"}, "rating": 5, "region_id": 32, "source": null, "text": "Проводили в этом баре встречу институтских друзей. Отмечали 20-летие нашего выпускного. И это было незабываемо! Наша молодость прошла в том числе под музыку Руки Вверх! До сих пор помним наизустиь \"Студент\", \"Чужие губы\" и конечно \"Крошка моя\". Ностальгия по ушедшей молодости может быть весёлой! Вся грусть мигом развеялась, когда мы нашей дружной компанией пропели все эти мегахиты в караоке. Сама атмосфера просто супер! Обслуживание, меню и напитки - всё по высшему разряду. Атмосфера праздника удалась на славу. Разъезжались по домам мы уже ночью. Обязательно придём компанией ещё и думаю не раз.", "url": "https://flamp.ru/r/70000001034739765/8729776", "user": {"additional_data": {"email": null}, "first_name": "Михаил", "id": "5216132", "last_name": null, "name": "Михаил", "photo_preview_urls": {"1920x": "https://cdn1.flamp.ru/e08ae1109a18a13d39b8d758793e279c_1920.png", "320x": "https://cdn1.flamp.ru/e08ae1109a18a13d39b8d758793e279c_320.png", "640x": "https://cdn1.flamp.ru/e08ae1109a18a13d39b8d758793e279c_640.png", "64x64": "https://cdn1.flamp.ru/e08ae1109a18a13d39b8d758793e279c_64_64.png", "url": "https://cdn1.flamp.ru/e08ae1109a18a13d39b8d758793e279c.png"}, "provider": "flamp", "public_id": null, "reviews_count": 1, "url": "http://flamp.ru/user5216132"}}, {"additional_data": {"external_id": "8714188", "filtered_facts": null, "has_unresolved_complaints": false, "ip": "", "is_liked": null, "is_unrated_permanently": null, "pin_status": "none", "status_history": [], "user_agent": ""}, "comments_count": 1, "date_created": "2023-12-02T11:17:44.0+07:00", "date_edited": null, "hiding_reason": null, "hiding_type": null, "id": "66783192", "is_hidden": false, "is_rated": true, "likes_count": 0, "media": [], "object": {"id": "70000001034739765", "type": "branch"}, "official_answer": {"date_created": "2023-12-03T20:23:16.0+07:00", "id": "23702125", "logo_preview_urls": {"1920x": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_1920.png", "320x": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_320.png", "640x": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_640.png", "64x64": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_64_64.png", "url": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77.png"}, "org_name": "Руки Вверх!, бар", "text": "С нами вы не заскучаете 100%😎\nПоэтому до скорой встречи! 🧡"}, "provider": "flamp", "provider_data": {"caption": "Flamp", "icon_url": "https://cachizer1.2gis.com/reviews-logos/984693dc-de95-4acc-8d1b-35d906b17374.png?h={height}&w={width}"}, "rating": 5, "region_id": 32, "source": null, "text": "Руки ВВерх! бар просто пушка! Как только я переступила порог, меня сразу окунула волна ностальгии) Интерьер бара пропитан атмосферой времени - сразу вспомнила юность) Каждые выходные здесь проходят вечеринки. \nОбширная подборка караоке с ретро-хитами, есть и современные композиции.  Список блюд, хоть и небольшой, но разнообразный, есть хорошая винная карта. Персонал очень доброжелательный, никогда не оставят без внимания. Непременно рекомендую к посещению!", "url": "https://flamp.ru/r/70000001034739765/8714188", "user": {"additional_data": {"email": null}, "first_name": "Zhenya Morozova", "id": "5208655", "last_name": null, "name": "Zhenya Morozova", "photo_preview_urls": {"1920x": "https://cdn1.flamp.ru/7594cfd93d1e55528efb34492d8f127a_1920.jpg", "320x": "https://cdn1.flamp.ru/7594cfd93d1e55528efb34492d8f127a_320.jpg", "640x": "https://cdn1.flamp.ru/7594cfd93d1e55528efb34492d8f127a_640.jpg", "64x64": "https://cdn1.flamp.ru/7594cfd93d1e55528efb34492d8f127a_64_64.jpg", "url": "https://cdn1.flamp.ru/7594cfd93d1e55528efb34492d8f127a.jpg"}, "provider": "flamp", "public_id": null, "reviews_count": 2, "url": "http://flamp.ru/user5208655"}}, {"additional_data": {"external_id": "8707355", "filtered_facts": null, "has_unresolved_complaints": false, "ip": "", "is_liked": null, "is_unrated_permanently": null, "pin_status": "none", "status_history": [], "user_agent": ""}, "comments_count": 1, "date_created": "2023-11-29T02:53:00.0+07:00", "date_edited": null, "hiding_reason": null, "hiding_type": null, "id": "66439461", "is_hidden": false, "is_rated": true, "likes_count": 0, "media": [], "object": {"id": "70000001034739765", "type": "branch"}, "official_answer": {"date_created": "2023-11-30T13:36:05.0+07:00", "id": "23607647", "logo_preview_urls": {"1920x": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_1920.png", "320x": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_320.png", "640x": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_640.png", "64x64": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77_64_64.png", "url": "https://cdn1.flamp.ru/392c9de16e9ee01b0a5fb82a25284e77.png"}, "org_name": "Руки Вверх!, бар", "text": "Спасибо, нам приятно 😊\nБудем еще лучше стараться делать отдых максимально комфортным.\nРады, что оценили бар. Дальше - больше!"}, "provider": "flamp", "provider_data": {"caption": "Flamp", "icon_url": "https://cachizer1.2gis.com/reviews-logos/984693dc-de95-4acc-8d1b-35d906b17374.png?h={height}&w={width}"}, "rating": 5, "region_id": 32, "source": null, "text": "Бар высшей атмосферы ностальгии, в который хочется возвращаться снова и снова. Здесь собираются все кто уважает руки вверх и зажигал под них в самый разгар молодости. Как будто получаешь возможность прожить те прекрасные моменты еще раз! Здесь хорошие закуски и напитки, прекрасный персонал, все комфортно и душевно. Получаешь массу положительных", "url": "https://flamp.ru/r/70000001034739765/8707355", "user": {"additional_data": {"email": null}, "first_name": "Maria Lopotka", "id": "5205399", "last_name": null, "name": "Maria Lopotka", "photo_preview_urls": {"1920x": "https://cdn1.flamp.ru/8a8995ebb02457a0627619cd24b9e038_1920.jpg", "320x": "https://cdn1.flamp.ru/8a8995ebb02457a0627619cd24b9e038_320.jpg", "640x": "https://cdn1.flamp.ru/8a8995ebb02457a0627619cd24b9e038_640.jpg", "64x64": "https://cdn1.flamp.ru/8a8995ebb02457a0627619cd24b9e038_64_64.jpg", "url": "https://cdn1.flamp.ru/8a8995ebb02457a0627619cd24b9e038.jpg"}, "provider": "flamp", "public_id": null, "reviews_count": 1, "url": "http://flamp.ru/user5205399"}}]}